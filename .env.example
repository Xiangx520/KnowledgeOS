# 默认可离线演示：SQLite + Qdrant local + 哈希向量 + 原文摘录。
# 在项目根目录复制为 .env。不要提交真实密钥。
RAG_ENVIRONMENT=development
RAG_DATABASE_URL=sqlite:///./data/rag.db
RAG_DATA_DIR=./data
RAG_SECRET_KEY=development-only-change-this-secret-before-production
RAG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RAG_MAX_UPLOAD_MB=50
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_CACHE_TTL=3600
RAG_AGENT_MAX_REWRITES=2

# hash 仅验证链路，不具备真实语义理解。正式使用改为 sentence-transformers 或 openai。
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIMENSION=384
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# API 精排使用百炼原生 Rerank 地址（不是 /compatible-mode/v1）。
RAG_RERANKER_PROVIDER=local
RAG_RERANKER_API_URL=
RAG_RERANKER_API_KEY=

# 任意 OpenAI 兼容接口，包括本机 Ollama/vLLM 或云端服务。
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
# Qwen-VL/vLLM 兼容接口上的视觉模型名，共用上面的地址与key。
RAG_VISION_MODEL=
RAG_OCR_ENABLED=false

# 开启 Redis 时同时配置 Qdrant server，并另起 python -m app.worker。
RAG_REDIS_URL=
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=
