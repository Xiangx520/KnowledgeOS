# 默认可离线演示：SQLite + Qdrant local + 哈希向量 + 原文摘录。
# 在项目根目录复制为 .env。不要提交真实密钥。
RAG_ENVIRONMENT=development
RAG_DATABASE_URL=sqlite:///./data/rag.db
RAG_DATA_DIR=./data
RAG_SECRET_KEY=development-only-change-this-secret-before-production
RAG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RAG_MAX_UPLOAD_MB=50
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Optional model-assisted source excerpts; originals remain citation evidence.
RAG_CONTEXT_ENRICHMENT_ENABLED=false
RAG_CONTEXT_ENRICHMENT_MAX_CALLS=16
RAG_CONTEXT_ENRICHMENT_MAX_BYTES=12000
RAG_CONTEXT_ENRICHMENT_TIMEOUT=30
RAG_CACHE_TTL=3600
RAG_AGENT_MAX_REWRITES=2

# 有界单 Agent 检索循环。默认关闭时 mode=agent 走原有有界流程。
# 需要已配置模型；关闭开关即可回退，standard 不受影响。
RAG_AGENT_LOOP_ENABLED=false
RAG_AGENT_MAX_STEPS=6
RAG_AGENT_MAX_TOOL_CALLS=8
RAG_AGENT_MAX_MODEL_CALLS=12
RAG_AGENT_MAX_TOTAL_TOKENS=24000
RAG_AGENT_DEADLINE_SECONDS=120
RAG_AGENT_MAX_EVIDENCE_CHUNKS=24
RAG_AGENT_MAX_DYNAMIC_TASKS=8
RAG_AGENT_MAX_RECOVERY_ROUNDS=1
# 低于此覆盖率的候选不进入 agent 证据账本；默认与标准召回下限一致。
RAG_AGENT_MIN_SEARCH_COVERAGE=0.25
RAG_AGENT_MAX_QUERY_CHARS=600
RAG_AGENT_MAX_OBSERVATION_CHARS=6000
RAG_AGENT_MAX_EVIDENCE_CHARS=4000
RAG_AGENT_MAX_LEDGER_CHARS=48000
RAG_AGENT_GENERATION_RESERVE_MODEL_CALLS=2
RAG_AGENT_GENERATION_RESERVE_TOKENS=1500

# hash 仅验证链路，不具备真实语义理解。正式使用改为 sentence-transformers 或 openai。
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIMENSION=384
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# API 精排使用百炼原生 Rerank 地址（不是 /compatible-mode/v1）。
RAG_RERANKER_PROVIDER=local
RAG_RERANKER_API_URL=
RAG_RERANKER_API_KEY=

# 任意 OpenAI 兼容接口，包括本机 Ollama/vLLM 或云端服务。
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
# Qwen-VL/vLLM 兼容接口上的视觉模型名，共用上面的地址与key。
RAG_VISION_MODEL=
RAG_OCR_ENABLED=false

# 开启 Redis 时同时配置 Qdrant server，并另起 python -m app.worker。
RAG_REDIS_URL=
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=
